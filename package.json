{
  "name": "armani-caffe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11.12.1 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:local": "npm run build && npm run start",
    "env:init": "node scripts/create-local-env.mjs",
    "infra:up": "docker compose -f infra/compose.yaml up -d --wait mongodb redis minio",
    "infra:init:mongo": "docker compose -f infra/compose.yaml --profile init run --rm mongo-init",
    "infra:init:minio": "docker compose -f infra/compose.yaml --profile init run --rm minio-init",
    "infra:status": "docker compose -f infra/compose.yaml ps",
    "infra:down": "docker compose -f infra/compose.yaml down",
    "infra:smoke": "node scripts/smoke-infra.mjs",
    "db:migrate:status": "node --conditions=react-server scripts/db.mjs migrate:status",
    "db:migrate:up": "node --conditions=react-server scripts/db.mjs migrate:up",
    "db:indexes:plan": "node --conditions=react-server scripts/db.mjs indexes:plan",
    "db:indexes:apply": "node --conditions=react-server scripts/db.mjs indexes:apply",
    "db:seed": "node --conditions=react-server scripts/db.mjs seed",
    "admin:bootstrap": "node --conditions=react-server scripts/admin-bootstrap.mjs",
    "db:smoke": "node --conditions=react-server scripts/db.mjs smoke",
    "outbox:work": "node --conditions=react-server scripts/outbox.mjs work",
    "realtime:work": "node --conditions=react-server scripts/realtime.mjs",
    "bridge:run": "node --experimental-strip-types bridge/cli.ts run",
    "bridge:status": "node --experimental-strip-types bridge/cli.ts status",
    "bridge:doctor": "node --experimental-strip-types bridge/cli.ts doctor",
    "bridge:resolve": "node --experimental-strip-types bridge/cli.ts resolve",
    "outbox:replay": "node --conditions=react-server scripts/outbox.mjs replay",
    "media:cleanup": "node --conditions=react-server scripts/media-cleanup.mjs",
    "payment:inquire": "node --conditions=react-server scripts/payments.mjs inquire",
    "payment:fake:settle": "node --conditions=react-server scripts/payments.mjs fake:settle",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:boundaries": "node scripts/check-server-boundaries.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "test:unit": "vitest run --project unit --project client",
    "test:unit:watch": "vitest --project unit --project client",
    "test:integration": "vitest run --project integration",
    "test:printing:resilience": "vitest run --project integration tests/integration/orders.test.ts tests/integration/printing.test.ts",
    "test:reliability": "npm run test:reliability:unit && npm run test:reliability:integration",
    "test:reliability:unit": "vitest run --project unit tests/unit/recovering-loop.test.ts tests/unit/redis-startup.test.ts tests/unit/readiness.test.ts tests/unit/shutdown.test.ts tests/unit/database-lifecycle.test.mjs",
    "test:reliability:integration": "vitest run --project integration tests/integration/payments.test.ts tests/integration/orders.test.ts tests/integration/printing.test.ts",
    "test:printing:redis": "vitest run --project integration tests/integration/redis-queue.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:dashboard": "node scripts/run-dashboard-e2e.mjs",
    "test:e2e:dashboard:smoke": "node scripts/run-e2e.mjs --with-admin-db --workers=1 dashboard-auth.spec.ts dashboard-journeys.spec.ts",
    "test:e2e:products": "node scripts/run-e2e.mjs --with-product-fixtures dashboard-products.spec.ts",
    "test:e2e:media": "node scripts/run-e2e.mjs --with-media-fixtures dashboard-media.spec.ts",
    "test:e2e:categories": "node scripts/run-e2e.mjs --with-product-fixtures dashboard-categories.spec.ts",
    "test:e2e:admins": "node scripts/run-e2e.mjs --with-admin-db dashboard-admins.spec.ts",
    "test:e2e:customers": "node scripts/run-e2e.mjs --with-admin-db dashboard-customers.spec.ts",
    "test:e2e:orders": "node scripts/run-e2e.mjs --with-admin-db dashboard-orders.spec.ts",
    "test:e2e:order-detail": "node scripts/run-e2e.mjs --with-admin-db dashboard-order-detail.spec.ts",
    "test:e2e:inventory": "node scripts/run-e2e.mjs --with-admin-db dashboard-inventory.spec.ts",
    "test:e2e:payment-settings": "node scripts/run-e2e.mjs --with-admin-db dashboard-payment-settings.spec.ts",
    "test:e2e:business-settings": "node scripts/run-e2e.mjs --with-admin-db dashboard-business-settings.spec.ts",
    "test:e2e:shared-states": "node scripts/run-e2e.mjs shared-states-accessibility.spec.ts",
    "test:e2e:storefront": "node scripts/run-e2e.mjs menu-page.spec.ts customer-auth-ui.spec.ts menu-cart.spec.ts cart-checkout.spec.ts payments.spec.ts storefront-journeys.spec.ts",
    "test:performance": "node scripts/run-e2e.mjs --with-product-fixtures --workers=1 performance.spec.ts",
    "test:e2e:debug": "node scripts/run-e2e.mjs --debug",
    "test:e2e:ui": "node scripts/run-e2e.mjs --ui",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run check:boundaries && npm run check:architecture && npm run test:unit && npm run test:integration && npm run test:e2e"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1141.0",
    "@aws-sdk/lib-storage": "3.1141.0",
    "@aws-sdk/s3-presigned-post": "3.1141.0",
    "@aws-sdk/s3-request-presigner": "3.1141.0",
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource-variable/vazirmatn": "5.3.0",
    "@mui/material": "9.4.0",
    "@mui/material-nextjs": "9.4.0",
    "@mui/stylis-plugin-rtl": "7.3.1",
    "mongoose": "9.10.2",
    "next": "16.3.6",
    "playwright": "1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "redis": "6.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "stylis": "4.3.6",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/stylis": "4.2.7",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "jsdom": "30.1.1",
    "mongodb-memory-server": "11.3.0",
    "prettier": "3.9.9",
    "typescript": "^5",
    "vitest": "5.0.2"
  }
}
