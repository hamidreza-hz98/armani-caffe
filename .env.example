# Development-only example. Copy via `npm run env:init`; never commit .env.local.
# APP_URL and ADMIN_URL are canonical server-side origins (no path/query).
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3000

# These are the ONLY values intentionally exposed to browser bundles.
# They are fixed at build time by Next.js.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws

# Host-side MongoDB URL. The single-node replica set advertises its Docker DNS name,
# so host clients need directConnection=true.
MONGODB_URI=mongodb://127.0.0.1:27017/armani_caffe?directConnection=true&replicaSet=rs0
# Local Redis has no authentication. Production must use protected infrastructure.
REDIS_URL=redis://127.0.0.1:6379

# Local MinIO API and private media bucket. These credentials match the deliberately
# unsafe Compose DEVELOPMENT defaults; replace them outside local development.
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_REGION=us-east-1
MINIO_BUCKET=armani-media
MINIO_ACCESS_KEY=armani_dev
MINIO_SECRET_KEY=armani_dev_password_change_me

# At least 32 random characters each; keep customer and admin secrets distinct.
# `npm run env:init` generates these in the ignored .env.local file.
AUTH_SESSION_SECRET=
AUTH_ADMIN_SESSION_SECRET=

# 32 random bytes as 64 hexadecimal characters. Previous key is optional for rotation.
ENCRYPTION_KEY=
ENCRYPTION_KEY_PREVIOUS=

# Public origin used to construct provider callbacks; no private payment token here.
PAYMENT_CALLBACK_BASE_URL=http://localhost:3000

# Realtime process configuration; browser URL above should route to this process.
WEBSOCKET_PORT=3001
WEBSOCKET_PATH=/ws
WEBSOCKET_HEARTBEAT_MS=30000

# Printer bridge identity and a distinct random token of at least 32 characters.
PRINTER_BRIDGE_ID=local-printer-bridge
PRINTER_BRIDGE_TOKEN=

# debug | info | warn | error; pretty | json
LOG_LEVEL=debug
LOG_FORMAT=pretty

# Test-only overrides. Leave commented outside NODE_ENV=test.
# TEST_FIXED_TIME=2025-01-01T00:00:00.000Z
# TEST_RANDOM_SEED=42
