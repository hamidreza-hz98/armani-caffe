# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/.nyc_output/

# next.js
/.next/
/out/

# production
/build
/dist/
/tmp/
/temp/
/uploads/
/storage/
/volumes/
/data/
*.log

# misc
.DS_Store
*.pem
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.*.example
!.env.schema

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
