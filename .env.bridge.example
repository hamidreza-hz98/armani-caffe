# Café computer only; copy to .env.bridge.local and restrict access to this file.
BRIDGE_REALTIME_URL=ws://127.0.0.1:3001/ws?role=bridge
BRIDGE_PRINTER_ID=cafe-counter
# Must match the encrypted printing-settings bridge token; use a random 32+ character secret.
BRIDGE_TOKEN=replace-with-a-random-32-character-or-longer-secret
BRIDGE_ADAPTER=file
BRIDGE_DATA_DIR=./data/print-bridge
# For network mode only; raw ESC/POS printers commonly listen on a configured TCP port.
# BRIDGE_NETWORK_HOST=192.168.1.100
# BRIDGE_NETWORK_PORT=9100
# For Windows RAW spool mode only; use the exact installed Windows printer name.
# BRIDGE_WINDOWS_PRINTER=Your printer name
# Optional locally installed Chrome/Edge channel if Playwright Chromium is unavailable.
# BRIDGE_BROWSER_CHANNEL=chrome
